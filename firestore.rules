rules_version = '2';

// Draft v1 — adapted from a sibling Firebase project's security-rule patterns
// (field-scoped update branches, approval gating, rate-limit collections).
// See docs/ARCHITECTURE.md for the full collection map and open decisions.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin status is keyed by (verified) email, not uid — so a specific
    // Google account can be pre-authorized as an admin in the console
    // before they've ever signed in even once (no uid to key on yet).
    function isAdmin() {
      return isSignedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // A profile counts as "approved" once an admin has cleared it (or it
    // auto-approved and hasn't been flagged/rejected since).
    function isApproved(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.approved == true;
    }

    function isBlockedPair(uidA, uidB) {
      let pairId = uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
      return exists(/databases/$(database)/documents/blocks/$(pairId));
    }

    // ---------------------------------------------------------------------
    // Admin allowlist, keyed by email — written only via the Firebase
    // console, never by users or client code. The doc's existence is the
    // whole grant; contents don't matter (an empty {} doc is fine).
    // ---------------------------------------------------------------------
    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // adminPinAttempts/{uid} — the second-factor PIN lockout counter for
    // the admin portal (see functions/index.js verifyAdminPin). Written
    // only by that Cloud Function via the Admin SDK, which bypasses rules
    // entirely — never read or written by any client, so no rule needed
    // beyond the default deny-all catch-all below.
    // ---------------------------------------------------------------------

    // ---------------------------------------------------------------------
    // towns/{townId} — live per-town walker-cap counter. The full Oklahoma
    // town/county/population list itself lives as a static asset shipped
    // with hosting (public/data/ok-towns.json) — nothing to seed here.
    // A doc in this collection only exists once someone has actually
    // signed up from that town: the signup flow self-registers it the
    // first time, seeded from that same static list (see public/signup.html).
    // Once a doc exists, only an admin/Cloud Function can change it — a
    // regular user can create the doc but never edit an existing one, so
    // approvedWalkerCount can't be tampered with client-side.
    // ---------------------------------------------------------------------
    match /towns/{townId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['name', 'county', 'population', 'walkerCap', 'approvedWalkerCount', 'status'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.county is string
                    && request.resource.data.population is int && request.resource.data.population > 0
                    && request.resource.data.walkerCap is int && request.resource.data.walkerCap > 0
                    && request.resource.data.approvedWalkerCount == 0
                    && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // users/{uid}/notifications/{notifId} — the in-app notification bell.
    // Written only by Cloud Functions (logInAppNotification, Admin SDK
    // bypasses rules) — a client can read their own, and can mark one of
    // their own as read, but can never create or delete one directly.
    // ---------------------------------------------------------------------
    match /users/{uid}/notifications/{notifId} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow update: if isOwnerUid(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // users/{uid} — core identity for both owners and walkers.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if (isSignedIn() && isApproved(request.auth.uid) && resource.data.approved == true)
                  || isOwnerUid(uid) || isAdmin();

      allow create: if isOwnerUid(uid)
                    && request.resource.data.approved == false
                    && request.resource.data.everApproved == false
                    && request.resource.data.role in ['owner', 'walker', 'both']
                    && request.resource.data.townId is string
                    && exists(/databases/$(database)/documents/towns/$(request.resource.data.townId));

      allow update: if isAdmin()
                    // Profile edits (name/photo/bio/role/location) — self-service,
                    // blocked once a SafeSearch flag is sitting on the current doc.
                    // approved/everApproved/rejected are deliberately NOT in this
                    // list — those only ever change via the isAdmin() branch above
                    // (the admin portal). A value that's genuinely unchanged never
                    // shows up in diff().affectedKeys(), so this only blocks actual
                    // attempts to move them.
                    || (isOwnerUid(uid)
                        && resource.data.get('safeSearchFlag', {}).get('flagged', false) == false
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['profile', 'role', 'lastEditedAt', 'photo']))
                    // Admin/consent fields — always writable regardless of approval.
                    || (isOwnerUid(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastActiveAt', 'agreedToTerms', 'agreedToTermsAt']))
                    // Notification settings — gated on approval, same as the source project.
                    || (isOwnerUid(uid)
                        && isApproved(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['notificationsEnabled', 'fcmTokens']));

      allow delete: if isOwnerUid(uid) || isAdmin();
    }

    // ---------------------------------------------------------------------
    // walkerProfiles/{uid} — the paid, public-facing walker listing.
    // listingPaidUntil is Stripe-webhook/admin-only, mirrors businessPaidUntil.
    // ---------------------------------------------------------------------
    match /walkerProfiles/{uid} {
      allow read: if (isSignedIn() && isApproved(request.auth.uid) && resource.data.approved == true)
                  || isOwnerUid(uid) || isAdmin();

      allow create: if isOwnerUid(uid)
                    && request.resource.data.approved == false
                    && request.resource.data.everApproved == false
                    && request.resource.data.get('listingPaidUntil', null) == null;

      // Same rule as users/{uid} above: approved/everApproved/rejected are
      // admin-only (isAdmin() branch), never in the self-service hasOnly list.
      allow update: if isAdmin()
                    || (isOwnerUid(uid)
                        && resource.data.get('safeSearchFlag', {}).get('flagged', false) == false
                        && request.resource.data.get('listingPaidUntil', null) == resource.data.get('listingPaidUntil', null)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['bio', 'serviceRadius', 'hourlyRate', 'availability', 'lastEditedAt', 'photo']));

      allow delete: if isOwnerUid(uid) || isAdmin();
    }

    // ---------------------------------------------------------------------
    // dogs/{dogId} — owned by a single user (the dog's owner).
    // ---------------------------------------------------------------------
    match /dogs/{dogId} {
      allow read: if isSignedIn()
                  && (resource.data.ownerId == request.auth.uid
                      || isAdmin()
                      // a walker with an active booking for this dog can read it —
                      // enforced app-side by only surfacing dogIds from their own bookings;
                      // revisit if this needs to be a hard rule guarantee later.
                      || isApproved(request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid || isAdmin();
    }

    // ---------------------------------------------------------------------
    // conversations/{ownerUid}_{walkerUid} — 1:1 DMs.
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create, update: if isSignedIn()
                            && request.auth.uid in request.resource.data.participants
                            && request.resource.data.participants.size() == 2;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in conversationId.split('_');
        allow create: if isSignedIn()
                      && (isApproved(request.auth.uid) || isAdmin())
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in conversationId.split('_')
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000
                      // NOTE: must use isBlockedPair(), not exists(blocks/$(conversationId))
                      // directly — conversationId is the fixed "{ownerUid}_{walkerUid}" order,
                      // while blocks docs are keyed by the *sorted* pair (see isBlockedPair()
                      // above), so a raw exists() check only worked by coincidence when
                      // ownerUid happened to sort first.
                      && !isBlockedPair(conversationId.split('_')[0], conversationId.split('_')[1]);
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // bookings/{bookingId} — a walk request and its lifecycle.
    // Only the owner or the walker on the booking can read/act on it.
    // Status transitions are enforced app-side by Cloud Functions for now;
    // revisit locking down valid status transitions in rules once the
    // booking flow is built out.
    // ---------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.ownerId
                      || request.auth.uid == resource.data.walkerId
                      || isAdmin());

      allow create: if isSignedIn()
                    && isApproved(request.auth.uid)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'requested'
                    && !isBlockedPair(request.resource.data.ownerId, request.resource.data.walkerId);

      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.walkerId)
                    // core booking terms are immutable once created — only status/notes move
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'notes', 'lastEditedAt']);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // reviews/{reviewId} — one review per completed booking, by the owner.
    // ---------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Safety: blocks / reports / bug reports — write-your-own, admin reads all.
    // ---------------------------------------------------------------------
    match /blocks/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in pairId.split('_');
      allow create: if isSignedIn() && request.auth.uid in pairId.split('_');
      allow delete: if isSignedIn() && request.auth.uid in pairId.split('_');
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bugReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Rate limits — written only by Cloud Functions (Admin SDK bypasses rules).
    // ---------------------------------------------------------------------
    match /messageLimits/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow write: if false;
    }

    match /bookingLimits/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
